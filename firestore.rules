rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '');
    }

    function approvedAdmin() {
      return signedIn()
        && userRole() == 'admin';
    }

    function ownsTask(taskId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.companyId == request.auth.uid;
    }

    function taskDeadlineIsOpen(taskId) {
      return taskId is string
        && taskId != ''
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.get('deadlineAt', null) is timestamp
        && request.time < get(/databases/$(database)/documents/tasks/$(taskId)).data.deadlineAt;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        userRole() == 'startup' ||
        approvedAdmin()
      );
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role in ['student', 'startup']
        && request.resource.data.get('adminApproved', false) == false;
      allow update: if signedIn() && request.auth.uid == userId
        && resource.data.get('role', '') != 'admin'
        && (
          request.resource.data.role == 'student' ||
          request.resource.data.role == 'startup' ||
          request.resource.data.role == null
        )
        && request.resource.data.get('adminApproved', false) == resource.data.get('adminApproved', false)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['skills']) ||
          (
            request.resource.data.get('role', '') == 'student' &&
            request.resource.data.skills is list &&
            request.resource.data.skills.size() <= 30
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'updatedAt',
          'deleteReason',
          'uid',
          'email',
          'displayName',
          'skills'
        ]);
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.companyId == request.auth.uid;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.companyId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.companyId;
    }

    match /submissions/{submissionId} {
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.studentId
        && request.resource.data.get('taskId', '') is string
        && taskDeadlineIsOpen(request.resource.data.taskId);
      allow read: if approvedAdmin() || (
        signedIn() && (
          request.auth.uid == resource.data.get('studentId', '') ||
          request.auth.uid == resource.data.get('companyId', '')
        )
      );
      allow update: if signedIn() && (
        (
          request.auth.uid == resource.data.studentId &&
          taskDeadlineIsOpen(resource.data.get('taskId', ''))
        ) ||
        (
          request.auth.uid == resource.data.companyId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'selectedByCompany',
            'selectedAt',
            'paymentAdded',
            'selectionFeedback',
            'startupRating',
            'startupId',
            'startupName',
            'startupEmail',
            'companyName',
            'selectedFiles'
          ])
        )
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.studentId;
    }

    match /task_approvals/{approvalId} {
      allow create: if signedIn() && (
        request.auth.uid == request.resource.data.companyId ||
        ownsTask(request.resource.data.taskId)
      );
      allow read: if signedIn() && (
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.companyId
      );
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.companyId;
      allow read: if signedIn() && (
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.companyId
      );
      allow update, delete: if false;
    }
  }
}
