PORT=3000
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# SMTP settings for OTP and student selection email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password-or-app-password
SMTP_FROM=your-email@example.com

# Firebase Admin credentials for authenticated student selection notifications
# Use a protected environment variable and never commit a real service-account key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional frontend API base URL if backend runs on a separate host
# VITE_API_BASE_URL=
